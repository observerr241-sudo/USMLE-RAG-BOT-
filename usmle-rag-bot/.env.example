# --- required ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
ADMIN_IDS=111111111,222222222
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# Comma-separated Gemini API keys (one per Google Cloud project gives the most rotation headroom)
GEMINI_API_KEYS=AIzaSy...key1,AIzaSy...key2,AIzaSy...key3

# --- optional ---
MONGODB_DB=usmle_rag_db
GENERATION_MODEL=gemini-2.5-flash
PRICE_TEXT=200 BDT/month
PAYMENT_INSTRUCTIONS="bKash (Personal): 01868712777 | Bank Account: 2901228025652"

# gemini-api-rotator tuning (free tier gemini-2.5-flash is ~10 requests/min per key)
ROTATOR_DB=data/rotator.db
ROTATOR_RPM_PER_KEY=10
ROTATOR_MAX_CONCURRENT_PER_KEY=2

# Webhook mode (leave empty for long polling, which needs no public URL)
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=
PORT=8080
